# Copiar a .env y completar antes de correr el backend.

# Cadena de conexion a PostgreSQL (Prisma). En Neon/Vercel Postgres son
# dos valores distintos (pooled/directa); en local con un Postgres propio
# las dos pueden ser la misma.
DATABASE_URL="postgresql://usuario:password@localhost:5432/rideexperience?schema=public"
DATABASE_URL_UNPOOLED="postgresql://usuario:password@localhost:5432/rideexperience?schema=public"

# Puerto donde levanta la API.
PORT=3000

# Secreto para firmar los JWT del panel administrativo. Generar uno propio,
# nunca reusar este valor en produccion.
JWT_SECRET="cambiar-este-valor-en-produccion"
JWT_EXPIRES_IN="8h"

# Origen permitido para CORS (el sitio de registro / panel admin).
CORS_ORIGIN="http://localhost:5173"

# Notificaciones de correo (Resend: https://resend.com). Sin
# RESEND_API_KEY el backend sigue funcionando normal, pero los correos
# solo se loguean en consola en vez de enviarse de verdad — util en
# desarrollo, hay que configurarlo antes de producción.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Eventos <no-reply@tudominio.com>"

# Audience de Resend (Resend -> Audiences -> Create Audience, copiar el
# id) usada para AVISO_PREVIO y AVISO_FINAL: esos dos se mandan como un
# Broadcast a toda la Audience en vez de un correo por asistente. Sin
# esto, esos avisos quedan en modo simulado (se loguean, no se mandan) --
# igual que RESEND_API_KEY vacia. CONFIRMACION no la usa, sigue siendo
# transaccional (un correo por asistente, con su codigo).
RESEND_AUDIENCE_ID=""

# Firma del webhook de Resend (Resend -> Webhooks -> Add Endpoint,
# apuntando a https://tu-api/api/notificaciones/webhook-resend). Resend
# te da un "Signing Secret" que empieza con "whsec_" al crearlo: va acá.
# Sin esto configurado, ese endpoint devuelve 503 en vez de procesar
# webhooks sin verificar.
RESEND_WEBHOOK_SECRET=""

# URL publica del sitio de registro (registro/), se usa como link
# "Ver información del evento" dentro de los correos. Opcional.
REGISTRO_SITIO_URL=""

# Secreto compartido para /api/notificaciones/cron (lo llama un
# scheduler externo o Vercel Cron). Sin esto, esa ruta queda abierta a
# cualquiera que la encuentre -- cualquier string largo sirve.
CRON_SECRET=""
