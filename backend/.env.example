# Copiar a .env y completar antes de correr el backend.

# Cadena de conexion a PostgreSQL (Prisma).
DATABASE_URL="postgresql://usuario:password@localhost:5432/rideexperience?schema=public"

# Puerto donde levanta la API.
PORT=3000

# Secreto para firmar los JWT del panel administrativo. Generar uno propio,
# nunca reusar este valor en produccion.
JWT_SECRET="cambiar-este-valor-en-produccion"
JWT_EXPIRES_IN="8h"

# Origen permitido para CORS (el sitio de registro / panel admin).
CORS_ORIGIN="http://localhost:5173"
