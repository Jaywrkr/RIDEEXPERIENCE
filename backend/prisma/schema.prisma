generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local, "rhel-openssl-3.0.x" para el runtime
  // serverless de Vercel (Amazon Linux) — sin esto el cliente compila
  // pero falla en runtime al desplegar ahi.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL: conexion pooled, la usa el cliente en runtime.
  // DATABASE_URL_UNPOOLED: conexion directa, la usan las migraciones
  // (Neon/Vercel Postgres inyectan ambas automaticamente al conectar la
  // integracion; en local, si solo definis DATABASE_URL, Prisma cae de
  // vuelta a esa misma para directUrl tambien).
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Administrador del panel (login del organizador del evento).
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  nombre       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

// Evento/congreso gestionado desde el panel (agenda, lugar, fecha).
model Evento {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  lugar       String
  fechaInicio DateTime @map("fecha_inicio")
  fechaFin    DateTime? @map("fecha_fin")

  // Fechas configurables de los 2 avisos programados (el de confirmacion
  // es inmediato, no se configura). Ver Notificacion.tipo.
  fechaAvisoPrevio DateTime? @map("fecha_aviso_previo")
  fechaAvisoFinal  DateTime? @map("fecha_aviso_final")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asistentes     Asistente[]
  notificaciones Notificacion[]

  @@map("eventos")
}

enum EstadoRegistro {
  REGISTRADO
  CANCELADO
}

// Persona inscrita a un evento.
model Asistente {
  id        String         @id @default(uuid())
  nombre    String
  correo    String
  telefono  String
  estado    EstadoRegistro @default(REGISTRADO)

  // Correlativo real, asignado por la base de datos en el momento del
  // INSERT: es lo unico que garantiza que dos registros simultaneos nunca
  // reciban el mismo numero (una lectura+escritura hecha a mano en la
  // app tiene ventana de carrera; una columna autoincremental de
  // Postgres no). El pasaporte visible es "ATT-" + (1000 + numero), asi
  // que el primero en registrarse es ATT-1001.
  numero Int @unique @default(autoincrement())

  // Momento en que el organizador marco su llegada el dia del evento
  // (check-in en la puerta). null = todavia no llego.
  llegadaEn DateTime? @map("llegada_en")

  eventoId String @map("evento_id")
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notificaciones Notificacion[]

  // Al retirarse la cedula, el correo pasa a ser la clave natural del
  // asistente: es lo unico que queda para impedir que la misma persona se
  // inscriba dos veces. Sin esta restriccion no habria nada que lo evite.
  // Como antes con la cedula, solo tiene que ser unico dentro del mismo
  // evento: la misma persona puede registrarse a congresos distintos.
  @@unique([eventoId, correo], name: "evento_correo_unico")
  @@map("asistentes")
}

enum TipoNotificacion {
  CONFIRMACION
  AVISO_PREVIO
  AVISO_FINAL
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  FALLIDA
}

// Registro de las 3 notificaciones de correo prometidas en la cotizacion.
// Se crea en el registro del asistente; el envio real (Semana 4) lo
// completa un job/cron que lee estado = PENDIENTE.
model Notificacion {
  id     String             @id @default(uuid())
  tipo   TipoNotificacion
  estado EstadoNotificacion @default(PENDIENTE)

  programadaPara DateTime? @map("programada_para")
  enviadaEn      DateTime? @map("enviada_en")

  // Todo lo de acá abajo lo completa el webhook de Resend
  // (notificaciones.controller.ts, POST /notificaciones/webhook-resend),
  // no procesarPendientes(): "enviada" es solo "Resend aceptó mandarlo",
  // estos campos son la confirmacion real de que salio de sus servidores.
  //
  // proveedorId es el id que Resend devuelve al aceptar el envio (id de
  // mailer.service.ts): es la unica forma de saber a que Notificacion
  // corresponde un evento de webhook, que no trae el id nuestro.
  proveedorId          String?   @map("proveedor_id")
  // Crudo del evento de Resend ("delivered", "bounced", "complained",
  // "delivery_delayed"...) en vez de un enum cerrado: si Resend agrega un
  // tipo de evento nuevo, lo seguimos guardando igual sin otra migracion.
  entregaEstado        String?   @map("entrega_estado")
  entregaActualizadaEn DateTime? @map("entrega_actualizada_en")
  abiertaEn            DateTime? @map("abierta_en")

  // AVISO_PREVIO y AVISO_FINAL van como Resend Broadcast, no correo por
  // correo: hay que sincronizar antes al asistente como contacto de la
  // Audience de Resend (una llamada API paceada, igual de sujeta al
  // limite de 2/s que antes). Esta bandera evita reintentar esa
  // sincronizacion en cada corrida del cron una vez que ya se hizo.
  // CONFIRMACION nunca la usa (queda en false, sin significado).
  sincronizadaEnAudiencia Boolean @default(false) @map("sincronizada_en_audiencia")

  eventoId    String    @map("evento_id")
  evento      Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  asistenteId String    @map("asistente_id")
  asistente   Asistente @relation(fields: [asistenteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([proveedorId])
  @@map("notificaciones")
}
